{
	"name": "jokateko-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run scripts/bundle.ts",
		"check:fix": "biome check --write && bun run scripts/check-tailwind.ts --fix",
		"check:tailwind": "bun run scripts/check-tailwind.ts",
		"check": "biome check && bun run scripts/check-tailwind.ts",
		"dev": "bun --hot scripts/dev.ts",
		"test:e2e": "bunx playwright test --config ../playwright.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@preact/signals": "^2.11.1",
		"@tailwindcss/typography": "^0.5.20",
		"bun-plugin-tailwind": "latest",
		"daisyui": "^5",
		"mermaid": "^11.17.2",
		"preact": "latest",
		"tailwindcss": "^4",
		"valibot": "latest"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@playwright/test": "^1.62.1",
		"@types/bun": "^1.4.0",
		"@types/node": "latest",
		"typescript": "latest"
	}
}
