{
	"name": "jokateko-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run scripts/bundle.ts",
		"check:fix": "biome check --write && bun run scripts/check-tailwind.ts --fix",
		"check:tailwind": "bun run scripts/check-tailwind.ts",
		"check": "biome check && bun run scripts/check-tailwind.ts",
		"dev": "bun --hot scripts/dev.ts",
		"test:e2e": "bunx playwright test --config ../playwright.config.ts",
		"test:lighthouse": "bunx playwright test --config ../playwright.lighthouse.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@preact/signals": "^2.11.4",
		"@tailwindcss/typography": "^0.5.20",
		"bun-plugin-tailwind": "^0.1.2",
		"daisyui": "^5.7.50",
		"lucide-preact": "^1.70.0",
		"mermaid": "^12.3.0",
		"preact": "11.2.0",
		"tailwindcss": "^4",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@playwright/test": "^1.65.0",
		"@types/bun": "^1.4.4",
		"@types/node": "26.6.6",
		"lighthouse": "^13.6.0",
		"typescript": "^7.0.2"
	}
}
