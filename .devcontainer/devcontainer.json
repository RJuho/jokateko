{
	"name": "jokateko",
	"build": {
		"dockerfile": "Dockerfile",
		"cacheFrom": [
			"ghcr.io/rjuho/jokateko-devcontainer:latest"
		]
	},
	"remoteUser": "bun",
	"postCreateCommand": "make skills",
	"forwardPorts": [8080, 4321],
	"portsAttributes": {
		"8080": {
			"label": "Jokateko Web",
			"onAutoForward": "notify"
		},
		"4321": {
			"label": "Web dev server",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"oven.bun-vscode",
				"biomejs.biome",
				"bradlc.vscode-tailwindcss",
				"golang.Go",
				"ms-vscode.makefile-tools",
				"GitHub.vscode-github-actions"
			],
			"settings": {
				"files.eol": "\n",
				"css.lint.unknownAtRules": "ignore",
				"[css]": {
					"editor.defaultFormatter": "bradlc.vscode-tailwindcss"
				},
				"biome.lsp.bin": "web/node_modules/@biomejs/biome/bin/biome",
				"biome.configurationPath": "web/biome.json",
				"editor.defaultFormatter": "biomejs.biome",
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.fixAll.biome": "explicit"
				}
			}
		}
	}
}
